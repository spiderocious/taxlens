NODE_ENV=development
PORT=8090
LOG_LEVEL=info

APP_BASE_URL=http://localhost:8090
WEB_BASE_URL=http://localhost:5173

# Persistence (v1.5 — stateful). See docs/product/statement-pipeline.md.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=taxlens

# OpenAI — Module 1 parse + Module 4 follow-up. Optional; the AI features
# degrade to a clearly-failed pipeline when absent.
OPENAI_API_KEY=
OPENAI_GATE_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o

# Circuit breaker around OpenAI.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# Reaper — nuke idle processes + audit after this idle window.
REAPER_INTERVAL_MS=300000
PROCESS_TTL_MS=3600000

# Max upload size for /statement/parse (bytes). Default 10MB.
STATEMENT_MAX_BYTES=10485760

# LLM transport. 'openai' = real API (default). 'stub' = deterministic in-process
# fake for tests/CI (rejected in production). See llm-stub-seam-spec.md.
LLM_MODE=openai
# Stub steering (only used when LLM_MODE=stub):
LLM_STUB_UNCONFIGURED=false
LLM_STUB_FAIL_TIMES=0
LLM_STUB_CHAT=answer
